<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' && metaDesc ? metaDesc : 'Explore YADEA electric scooters in Pakistan with stylish, high-performance, eco-friendly rides. Check scooty price, save fuel, reduce emissions, and ride smarter.' %>">
  <link rel="icon" href="/img/favicon.ico" onerror="this.remove()">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Roboto:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              orange: '#EB5F1B',
              accent: '#FF5F00',
              darkOrange: '#E04E00',
              dark: '#222222',
              footer: '#1F1F1F',
              cardBg: '#1A1A1A'
            }
          },
          fontFamily: {
            sans: ['Roboto', 'sans-serif'],
            heading: ['Roboto', 'sans-serif'],
            montserrat: ['Montserrat', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Roboto', sans-serif; background: #fff; color: #333; }
    h1, h2, h3, h4 { font-family: 'Roboto', sans-serif; font-weight: 600; }

    .banner-bg {
      background: linear-gradient(180deg, rgba(0,0,0,.55), rgba(0,0,0,.7)), url('https://yadea.com.pk/wp-content/uploads/2026/06/web.jpg');
      background-size: cover; background-position: center;
    }

    .ttfar-bg {
      background: linear-gradient(180deg, #02010145 36%, #000 100%), url('https://yadea.com.pk/wp-content/uploads/2026/03/1360x768-1.webp');
      background-size: cover; background-position: center right;
    }
    .adventure-bg {
      position: relative;
      min-height: 85vh;
      display: flex;
      align-items: center;
      background: url('/img/forest-road.jpg') center center / cover no-repeat #000;
      font-family: 'Roboto', sans-serif;
      text-align: center;
      color: var(--white);
    }
    .adv-section {
      --orange: #ff6a00;
      --white: #ffffff;
      --green: #10b981;
      --black: #000000;
    }
    .adv-overlay { position: absolute; inset: 0; background: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.5)); }
    .adv-inner { position: relative; z-index: 1; width: 100%; max-width: 1440px; margin: 0 auto; padding: 60px 20px; }
    .adv-label { color: var(--orange); font-size: 30px; font-weight: 400; letter-spacing: normal; margin-bottom: 4px; }
    .adv-title {
      font-size: clamp(32px, 4.5vw, 68px);
      font-weight: 700;
      color: var(--white);
      letter-spacing: -1px;
      line-height: 1.08;
      margin-bottom: 40px;
    }
    .adv-icons { display: flex; justify-content: center; flex-wrap: wrap; gap: 120px; margin-bottom: 40px; }
    .adv-item { display: flex; flex-direction: column; align-items: center; gap: 50px; }
    .adv-icon {
      width: 80px; height: 80px; border-radius: 50%;
      border: 3px solid var(--orange);
      background: transparent;
      display: flex; align-items: center; justify-content: center;
      transition: transform .3s ease, box-shadow .3s ease;
    }
    .adv-icon svg { width: 38px; height: 38px; color: var(--orange); }
    .adv-item:hover .adv-icon { transform: scale(1.08); box-shadow: 0 0 26px rgba(255,106,0,.55); }
    .adv-icon-label { color: var(--white); font-size: 22px; font-weight: 700; line-height: 1.2; max-width: 180px; text-align: center; }
    .adv-desc { color: var(--white); max-width: 640px; margin: 0 auto; font-size: 20px; line-height: 1.5; font-weight: 400; }
    .adv-cta { margin-top: 36px; }
    .adv-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--white);
      color: var(--black);
      font-family: 'Roboto', sans-serif;
      font-size: 19px;
      font-weight: 500;
      padding: 15px 42px;
      border-radius: 999px;
      text-decoration: none;
      transition: transform .3s ease, box-shadow .3s ease, background-color .3s ease, color .3s ease;
    }
    .adv-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0,0,0,.35); background: var(--orange); color: var(--white); }
    .adv-anim { opacity: 0; transform: translateY(30px); transition: opacity .7s ease, transform .7s ease; transition-delay: var(--d, 0s); }
    .adv-anim.is-visible { opacity: 1; transform: translateY(0); }
    @media (max-width: 1023px) {
      .adv-title { font-size: 44px; margin-bottom: 34px; }
      .adv-icons { gap: 70px; margin-bottom: 36px; }
      .adv-item { gap: 40px; }
      .adv-icon { width: 70px; height: 70px; }
      .adv-icon svg { width: 34px; height: 34px; }
      .adv-icon-label { font-size: 19px; }
      .adv-desc { font-size: 18px; }
      .adv-label { font-size: 26px; }
      .adv-btn { font-size: 17px; padding: 14px 36px; }
    }
    @media (max-width: 767px) {
      .adv-inner { padding: 50px 20px; }
      .adv-label { font-size: 20px; }
      .adv-title { font-size: 30px; margin-bottom: 28px; }
      .adv-icons { flex-direction: column; align-items: center; gap: 32px; margin-bottom: 32px; }
      .adv-item { gap: 22px; }
      .adv-icon { width: 64px; height: 64px; }
      .adv-icon svg { width: 30px; height: 30px; }
      .adv-icon-label { font-size: 18px; }
      .adv-desc { font-size: 16px; padding: 0 20px; }
      .adv-cta { margin-top: 28px; }
      .adv-btn { font-size: 16px; padding: 14px 32px; }
    }

    .lithium-bg {
      background: linear-gradient(180deg, #02010145 36%, #000 100%), url('https://yadea.com.pk/wp-content/uploads/2026/03/1360x768-2.webp');
      background-size: cover; background-position: center left;
    }
    .insights-bg {
      background: linear-gradient(180deg, #FFFFFF 36%, #BBBBBBB5 100%), url('https://yadea.com.pk/wp-content/uploads/2026/01/image-5.jpg');
      background-size: cover; background-position: center;
    }
    .popular-section {
      --pp-white: #ffffff;
      --pp-grey: #e5eaf0;
      --pp-black: #000000;
      --pp-green: #10b981;
      background: linear-gradient(135deg, var(--pp-white) 0%, var(--pp-grey) 100%);
      font-family: 'Roboto', sans-serif;
      color: var(--pp-black);
    }
    .pp-title {
      font-size: clamp(40px, 6vw, 72px);
      font-weight: 700;
      color: var(--pp-black);
      letter-spacing: -1px;
      line-height: 1.1;
      margin-bottom: 8px;
    }
    .pp-tabbar { display: inline-flex; align-items: center; background: var(--pp-white); border-radius: 999px; height: 70px; }
    .pp-tab {
      font-family: 'Roboto', sans-serif;
      font-size: 22px;
      font-weight: 500;
      color: var(--pp-black);
      background: transparent;
      border-radius: 999px;
      padding: 0 38px;
      height: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      transition: background-color .3s ease, color .3s ease;
    }
    .pp-tab:hover:not(.active) { background: rgba(0,0,0,.05); }
    .pp-tab.active { background: var(--pp-black); color: var(--pp-white); }
    .pp-stage { transition: opacity .4s ease, transform .4s ease; }
    .pp-stage.switching { opacity: 0; transform: translateY(16px); }
    .pp-img {
      width: min(480px, 80%);
      height: auto;
      filter: drop-shadow(0 24px 30px rgba(0,0,0,.18));
    }
    .pp-banner {
      width: min(868px, 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 10px 28px 0;
      gap: 12px;
    }
    .pp-banner-name {
      margin: 0;
      font-family: 'Roboto', sans-serif;
      font-size: clamp(24px, 3vw, 32px);
      font-weight: 700;
      color: var(--pp-black);
      letter-spacing: -.5px;
      line-height: 1.2;
    }
    .pp-banner-price {
      margin: 0;
      font-family: 'Roboto', sans-serif;
      font-size: clamp(32px, 4.5vw, 48px);
      font-weight: 900;
      color: #FF5A00;
      letter-spacing: -1px;
      line-height: 1.05;
    }
    .pp-learn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 10px;
      background: var(--pp-white);
      color: var(--pp-black);
      font-family: 'Roboto', sans-serif;
      font-size: 16px;
      font-weight: 500;
      padding: 14px 38px;
      border-radius: 999px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0,0,0,.10);
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .pp-learn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(0,0,0,.15);
    }
    .fab-cart {
      position: fixed; right: 40px; bottom: 40px;
      width: 90px; height: 90px; border-radius: 50%;
      background: var(--pp-black);
      display: flex; align-items: center; justify-content: center;
      z-index: 999;
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .fab-cart:hover { transform: scale(1.08); box-shadow: 0 12px 28px rgba(0,0,0,.35); }
    .fab-badge {
      position: absolute; top: -4px; left: -4px;
      width: 30px; height: 30px; border-radius: 50%;
      background: var(--pp-green); color: #fff;
      font-family: 'Roboto', sans-serif; font-weight: 700; font-size: 14px;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 2px 6px rgba(0,0,0,.25);
    }
    .fab-svg { width: 40px; height: 40px; }
    @media (max-width: 767px) {
      .pp-title { font-size: 40px; }
      .pp-tabbar { height: 52px; }
      .pp-tab { font-size: 16px; padding: 0 20px; }
      .pp-banner { padding: 6px 16px 0; }
      .pp-learn { font-size: 15px; padding: 12px 32px; }
      .fab-cart { width: 64px; height: 64px; right: 20px; bottom: 20px; }
      .fab-svg { width: 28px; height: 28px; }
      .fab-badge { width: 24px; height: 24px; font-size: 12px; top: -2px; left: -2px; }
    }
    .models-gradient { background: linear-gradient(105deg, #FFF5F5 0%, #E3E8ED 100%); }
    .seg-tab {
      font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 14px;
      padding: 11px 24px; border-radius: 9999px; color: #000; background: transparent;
      transition: background-color .3s ease, color .3s ease; white-space: nowrap;
    }
    .seg-tab:hover { background: rgba(0,0,0,.06); }
    .seg-tab.active { background: #000; color: #fff; }
    .model-panel { transition: opacity .35s ease; }
    .stores-gradient { background: linear-gradient(180deg, #FFFCFC00 50%, #F0F0F0 65%); }

    .big-overlay-title { text-shadow: 0 0 10px rgba(0,0,0,.84); }

    .pill-btn { border-radius: 30px; padding: 10px 28px; font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: .5px; transition: all .2s; }
    .pill-white { background: #fff; color: #000; }
    .pill-white:hover { background: #EB5F1B; color: #fff; }
    .pill-black { background: #000; color: #fff; }
    .pill-black:hover { background: #EB5F1B; color: #fff; }

    .tr-section {
      --white: #ffffff;
      --black: #000000;
      --green: #10b981;
      background: var(--white);
      font-family: 'Roboto', sans-serif;
      padding: 60px 30px;
    }
    .tr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; width: 100%; max-width: 1500px; margin: 0 auto; }
    .tr-card {
      position: relative;
      height: 460px;
      border-radius: 20px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      padding: 0 38px 38px;
    }
    .tr-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform .6s ease;
      z-index: 0;
    }
    .tr-card:hover .tr-img { transform: scale(1.04); }
    .tr-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.4) 40%, rgba(0,0,0,0) 70%);
      z-index: 1;
    }
    .tr-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      width: 100%;
      gap: 18px;
    }
    .tr-title {
      color: var(--white);
      font-size: 26px;
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -.3px;
      text-align: left;
      margin: 0;
      text-shadow: 0 2px 12px rgba(0,0,0,.5);
    }
    .tr-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--white);
      color: var(--black);
      font-family: 'Roboto', sans-serif;
      font-size: 16px;
      font-weight: 500;
      padding: 12px 28px;
      border-radius: 999px;
      border: none;
      box-shadow: 0 4px 16px rgba(0,0,0,.25);
      transition: background-color .3s ease, color .3s ease, transform .3s ease;
    }
    .tr-btn:hover { background: var(--black); color: var(--white); transform: translateY(-2px); }
    .tr-anim { opacity: 0; transform: translateY(40px); transition: opacity .7s ease, transform .7s ease; transition-delay: var(--d, 0s); }
    .tr-anim.is-visible { opacity: 1; transform: translateY(0); }
    @media (max-width: 1023px) {
      .tr-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
      .tr-card { height: 380px; padding: 0 28px 28px; }
      .tr-title { font-size: 22px; }
      .tr-btn { font-size: 15px; padding: 10px 24px; }
    }
    @media (max-width: 767px) {
      .tr-section { padding: 40px 20px 30px; }
      .tr-grid { grid-template-columns: 1fr; gap: 18px; }
      .tr-card { height: 340px; padding: 0 22px 24px; }
      .tr-title { font-size: 20px; }
      .tr-btn { font-size: 14px; padding: 10px 22px; }
    }

    /* ================= WHY YADEA ================= */
    .wy-section { background: #242424; padding: 55px 15px 65px; font-family: 'Roboto', sans-serif; }
    .wy-inner { max-width: 1890px; margin: 0 auto; }
    .wy-heading { margin: 0 0 16px; font-size: 28px; font-weight: 700; color: #fff; }
    .wy-intro { margin: 0 0 45px; font-size: 20px; font-weight: 400; color: #fff; line-height: 1.5; }
    .wy-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
    .wy-card { position: relative; background: #000; padding: 36px; min-height: 340px; }
    .wy-card + .wy-card { border-left: 2px dashed #555; }
    .wy-icon { display: block; color: #fff; font-size: 38px; margin-bottom: 20px; }
    .wy-title { margin: 0 0 14px; font-size: 23px; font-weight: 700; color: #fff; line-height: 1.2; }
    .wy-desc { margin: 0; font-size: 18px; font-weight: 400; color: #B0B0B0; line-height: 1.6; }
    .wy-plus {
      position: absolute; right: 30px; bottom: 30px;
      width: 40px; height: 40px; border-radius: 50%;
      background: #fff; color: #000;
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; font-weight: 400; line-height: 1;
      user-select: none;
    }
    @media (max-width: 1023px) {
      .wy-heading { font-size: 26px; }
      .wy-intro { font-size: 18px; margin-bottom: 36px; }
      .wy-grid { grid-template-columns: 1fr; }
      .wy-card { min-height: 0; padding: 28px 24px; }
      .wy-card + .wy-card { border-left: none; border-top: 2px dashed #555; }
      .wy-icon { font-size: 32px; margin-bottom: 16px; }
      .wy-title { font-size: 21px; }
      .wy-desc { font-size: 16px; }
      .wy-plus { right: 20px; bottom: 20px; width: 34px; height: 34px; font-size: 22px; }
    }

    /* ================= THE ELECTRIC EXPERIENCE ================= */
    .ee-section {
      background: #FFFFFF;
      padding: 110px 28px 90px;
      font-family: 'Roboto', Arial, sans-serif;
    }
    .ee-container { max-width: 1300px; margin: 0 auto; }
    .ee-heading {
      text-align: center;
      font-size: clamp(32px, 4.5vw, 56px);
      font-weight: 700;
      color: #0F0F0F;
      letter-spacing: -1px;
      line-height: 1.15;
      margin: 0 0 64px;
    }
    .ee-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      align-items: start;
    }
    .ee-card { display: flex; flex-direction: column; min-width: 0; }
    .ee-thumb {
      position: relative;
      aspect-ratio: 16 / 9;
      border-radius: 12px;
      overflow: hidden;
      background: #000;
      cursor: pointer;
    }
    .ee-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .35s ease;
    }
    .ee-card:hover .ee-thumb img { transform: scale(1.03); }
    .ee-thumb iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .ee-play {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }
    .ee-play svg {
      width: 68px;
      height: 48px;
      filter: drop-shadow(0 2px 6px rgba(0,0,0,.45));
      transition: transform .2s ease;
    }
    .ee-card:hover .ee-play svg { transform: scale(1.08); }
    .ee-body { padding-top: 16px; }
    .ee-channel {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 500;
      line-height: 1.3;
      color: #0F0F0F;
      margin-bottom: 10px;
    }
    .ee-channel svg { width: 20px; height: 20px; flex-shrink: 0; }
    .ee-title-row { display: flex; align-items: flex-start; gap: 8px; }
    .ee-cat { flex-shrink: 0; margin-top: 3px; color: #909090; }
    .ee-cat svg { width: 18px; height: 18px; display: block; }
    .ee-title {
      font-size: 18px;
      font-weight: 600;
      line-height: 1.35;
      color: #0F0F0F;
      text-decoration: none;
      transition: color .2s ease;
    }
    .ee-title:hover { color: #FF0000; }
    .ee-desc {
      font-size: 14px;
      line-height: 1.55;
      color: #606060;
      margin: 8px 0 0;
    }
    @media (max-width: 1023px) {
      .ee-grid { grid-template-columns: repeat(2, 1fr); gap: 28px; }
    }
    @media (max-width: 767px) {
      .ee-section { padding: 70px 20px 60px; }
      .ee-heading { margin-bottom: 44px; }
      .ee-grid { grid-template-columns: 1fr; gap: 30px; }
      .ee-title { font-size: 17px; }
      .ee-desc { font-size: 13.5px; }
      .ee-play svg { width: 56px; height: 40px; }
    }

    /* ================= SUPPORT / GENERIC PAGES ================= */
    /* Shared hero: full-width bg image + black 50% overlay + centered white heading */
    .ss-hero {
      position: relative;
      min-height: 360px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0A0605 url('https://yadea.com.pk/wp-content/uploads/2024/01/011A5230-scaled.jpg') center center / cover no-repeat;
    }
    .ss-hero-overlay { position: absolute; inset: 0; background: #000; opacity: .5; }
    .ss-hero-inner { position: relative; z-index: 1; text-align: center; padding: 40px 20px; }
    .ss-hero-title {
      margin: 0;
      font-family: 'Montserrat', sans-serif;
      font-size: 65px;
      font-weight: 600;
      line-height: 1.2;
      color: #fff;
    }
    @media (max-width: 767px) { .ss-hero { min-height: 240px; } .ss-hero-title { font-size: 40px; } }

    /* ---------- PRODUCT SUPPORT ---------- */
    .ps-lead-section {
      max-width: 1400px;
      margin: 0 auto;
      padding: 40px 20px 0;
    }
    .ps-lead {
      width: 80%;
      max-width: 80%;
      margin: 0;
      font-family: 'Montserrat', sans-serif;
      font-size: 24px;
      font-weight: 400;
      line-height: 41px;
      color: rgba(0, 0, 0, .65);
    }
    @media (max-width: 767px) { .ps-lead { width: 100%; max-width: 100%; font-size: 18px; line-height: 1.7; } }

    .ps-form-section {
      background: #F6F6F6;
      padding: 40px 20px;
      margin-top: 40px;
    }
    .ps-form-heading {
      margin: 20px 0;
      text-align: center;
      font-family: 'Montserrat', sans-serif;
      font-size: 40px;
      font-weight: 600;
      color: #000;
    }
    .ps-form {
      width: 50%;
      max-width: 50%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .ps-input {
      width: 100%;
      background: #fff;
      border: 1px solid #d5d8dc;
      border-radius: 3px;
      padding: 14px 16px;
      font-size: 16px;
      font-family: 'Roboto', sans-serif;
      color: #333;
      transition: border-color .2s, box-shadow .2s;
    }
    .ps-input::placeholder { color: #767676; }
    .ps-input:focus { border-color: #EB5F1B; box-shadow: 0 0 0 2px rgba(235,95,27,.15); outline: none; }
    .ps-select-wrap { position: relative; }
    .ps-select { appearance: none; -webkit-appearance: none; cursor: pointer; color: #333; }
