    <span class="fab-badge"><%= cartCount %></span>
    <svg class="fab-svg" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </svg>
  </a>

<script>
  (function () {
    window.switchModel = function (i) {
      document.querySelectorAll('.model-tab').forEach(function (t) { t.classList.remove('active'); });
      var tab = document.getElementById('tab-m' + i);
      if (tab) tab.classList.add('active');
      document.querySelectorAll('.model-panel').forEach(function (p, k) {
        if (k === i) {
          p.classList.remove('hidden');
          p.style.opacity = 0;
          requestAnimationFrame(function () { requestAnimationFrame(function () { p.style.opacity = 1; }); });
        } else {
          p.classList.add('hidden');
          p.style.opacity = '';
        }
      });
    };

    var PP_DATA = <%- JSON.stringify(popular.map(function (p) {
      return { name: p.name, slug: p.slug, image: p.image, price: p.price > 0 ? money(p.price) : '' };
    })) %>;

    window.switchPopular = function (i) {
      var d = PP_DATA[i];
      if (!d) return;
      document.querySelectorAll('.pp-tab').forEach(function (t, k) {
        t.classList.toggle('active', k === i);
        t.setAttribute('aria-selected', k === i ? 'true' : 'false');
      });
      var stage = document.getElementById('pp-stage');
      if (!stage) return;
      stage.classList.add('switching');
      setTimeout(function () {
        var img = document.getElementById('pp-img');
        img.src = d.image;
        img.alt = d.name;
        document.getElementById('pp-name').textContent = d.name;
        document.getElementById('pp-price').textContent = d.price;
        document.getElementById('pp-learn').href = '/models/' + d.slug;
        stage.classList.remove('switching');
      }, 400);
    };

    var advEls = document.querySelectorAll('.adv-anim, .tr-anim');
    if ('IntersectionObserver' in window) {
      var advIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) {
            en.target.classList.add('is-visible');
            advIo.unobserve(en.target);
          }
        });
      }, { threshold: 0.15 });
      advEls.forEach(function (el) { advIo.observe(el); });
    } else {
      advEls.forEach(function (el) { el.classList.add('is-visible'); });
    }

    function playThumb(thumb) {
      if (thumb.dataset.playing) return;
      thumb.dataset.playing = '1';
      var id = thumb.dataset.video;
      var title = thumb.getAttribute('aria-label') || 'YouTube video';
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
      iframe.title = title.replace(/^Play video:\s*/, '');
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      thumb.appendChild(iframe);
      var play = thumb.querySelector('.ee-play');
      var img = thumb.querySelector('img');
      if (play) play.style.display = 'none';
      if (img) img.style.visibility = 'hidden';
    }

    document.querySelectorAll('.ee-thumb').forEach(function (thumb) {
      thumb.addEventListener('click', function () { playThumb(thumb); });
      thumb.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); playThumb(thumb); }
      });
    });
  })();
</script>

