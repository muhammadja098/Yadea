<!-- ===================== GET IN TOUCH ===================== -->
<section class="ct-touch">
  <div class="ct-touch-inner">
    <h2>Get In Touch</h2>
    <p>Fill out the form below and we will contact you as soon as possible!</p>

    <% if (typeof query !== 'undefined' && query.sent) { %>
      <div style="background:#e6f7e6;border:1px solid #b6e6b6;color:#1c7a1c;border-radius:6px;padding:14px 18px;margin:20px auto 0;max-width:600px;font-family:'Poppins',sans-serif;font-size:14px;">
        Thank you! Your message has been received. Our team will contact you soon.
      </div>
    <% } %>

    <form method="POST" action="/contact-us" class="ct-form">
      <div class="ct-field">
        <label>Name <span class="ct-req">*</span></label>
        <input type="text" name="name" required>
      </div>
      <div class="ct-field">
        <label>Message or Email</label>
        <input type="text" name="email">
      </div>
      <div class="ct-field">
        <label>Phone Number <span class="ct-req">*</span></label>
        <input type="text" name="phone" required>
      </div>
      <div class="ct-field">
        <label>Subject <span class="ct-req">*</span></label>
        <select name="subject" required>
          <option value="" disabled selected>--- Select Choice ---</option>
          <option value="Dealership">Dealership</option>
          <option value="Vendor Distribution">Vendor Distribution</option>
          <option value="Export">Export</option>
          <option value="Service Dealership">Service Dealership</option>
          <option value="Product Inquiry">Product Inquiry</option>
        </select>
      </div>
      <div class="ct-field">
        <label>Comment or Message <span class="ct-req">*</span></label>
        <textarea name="message" required></textarea>
      </div>
      <button type="submit" class="ct-submit">Submit</button>
    </form>
  </div>
</section>

