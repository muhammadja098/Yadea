<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="content" class="py-16 bg-gray-50 min-h-[60vh]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-10 text-center">
      <div class="w-16 h-16 rounded-full bg-green-50 border border-green-200 mx-auto flex items-center justify-center text-green-500 mb-4">
        <i class="fa-solid fa-check text-2xl"></i>
      </div>
      <span class="text-xs font-bold text-brand-orange uppercase tracking-widest">Order confirmed</span>
      <h1 class="font-montserrat font-black text-3xl text-gray-900 mt-2 mb-3">Thank you, <%= order.customer_name %>!</h1>
      <p class="text-sm text-gray-500 max-w-md mx-auto">Your order <strong class="text-gray-900"><%= order.reference %></strong> has been placed successfully. Our team will contact you on <strong class="text-gray-900"><%= order.phone %></strong> to confirm.</p>
      <span class="inline-block mt-4 bg-amber-50 text-amber-600 border border-amber-200 text-xs font-semibold px-4 py-1.5 rounded-full capitalize"><%= order.status %></span>
    </div>

    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
      <div class="px-8 py-5 border-b border-gray-100">
        <h3 class="font-montserrat font-bold text-gray-900">Order details</h3>
      </div>
      <table class="w-full text-sm">
        <tbody>
          <% order.items.forEach(function (i, idx) { %>
            <tr class="<%= idx % 2 === 0 ? 'bg-gray-50' : '' %>">
              <td class="px-8 py-3 text-gray-700"><%= i.name %></td>
              <td class="px-8 py-3 text-gray-500 text-center">&times; <%= i.qty %></td>
              <td class="px-8 py-3 font-semibold text-gray-900 text-right"><%= money(i.total) %></td>
            </tr>
          <% }); %>
          <tr class="border-t border-gray-100">
            <td colspan="2" class="px-8 py-4 font-montserrat font-bold text-gray-900 text-right">Total</td>
            <td class="px-8 py-4 font-montserrat font-black text-brand-orange text-right text-lg"><%= money(order.total) %></td>
          </tr>
        </tbody>
      </table>
      <div class="px-8 py-5 bg-gray-50 text-xs text-gray-500 leading-relaxed border-t border-gray-100">
        <strong class="text-gray-700">Deliver to:</strong> <%= order.address %>, <%= order.city %><br>
        <strong class="text-gray-700">Payment:</strong> <%= order.payment_method.toUpperCase() %>
      </div>
    </div>

    <div class="text-center">
      <a href="/products" class="inline-block pill-btn pill-black">Continue Shopping</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
